# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # 1. Use the generic box (It exists, unlike Bento)
  config.vm.box = "rocky9"
  config.vm.box_url = "https://download.rockylinux.org/pub/rocky/9/images/aarch64/Rocky-9-Vagrant-Libvirt.latest.aarch64.box"
  config.vm.hostname = "nist-hardened-arm"

  # 2. THE FIX: Force Password Auth
  # This bypasses the SSH Key generation timeout that was blocking you.
  config.ssh.username = "vagrant"
  config.ssh.password = "vagrant"
  config.ssh.insert_key = true

  # Give it plenty of time to boot
  config.vm.boot_timeout = 600

  config.vm.provider "qemu" do |qe|
    qe.machine = "virt"
    qe.cpu = "max"
    qe.memory = "2048"
    qe.net_device = "virtio-net-device"
    qe.arch = "aarch64"

    # 3. Hardware Fixes: Add RNG for speed, GPU for console safety
    qe.extra_qemu_args = %w(-device virtio-rng-pci -device virtio-gpu-pci -display none)
  end

  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "nist_full_remediate.yml"
    ansible.config_file = "ansible.cfg"
    ansible.compatibility_mode = "2.0"
    ansible.extra_vars = {
      ansible_python_interpreter: "/usr/bin/python3"
    }
  end
end
