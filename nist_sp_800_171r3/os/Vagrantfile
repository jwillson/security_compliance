# -*- mode: ruby -*-
# vi: set ft=ruby :

# 1. Detect the Environment
# -------------------------
# Check if we are on Apple Silicon (M1/M2/M3)
IS_ARM_MAC = (Vagrant::Util::Platform.darwin? && `uname -m`.strip == "arm64")
# Check if we are on a standard Linux Host (e.g., Ubuntu/Fedora)
IS_LINUX   = Vagrant::Util::Platform.linux?

Vagrant.configure("2") do |config|

  # 2. Common Settings (Applies to everyone)
  # -------------------------
  config.vm.hostname = "nist-hardened"
  config.vm.boot_timeout = 600

  # The Provisioner is the same for all platforms
  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "nist_full_remediate.yml"
    ansible.config_file = "ansible.cfg"
    ansible.compatibility_mode = "2.0"
    ansible.extra_vars = {
      ansible_python_interpreter: "/usr/bin/python3"
    }
  end

  # ------------------------------------------------------------------------
  # SCENARIO A: APPLE SILICON (Your M3 Mac)
  # Limitation: Fast, but no Snapshots/Packaging support yet.
  # ------------------------------------------------------------------------
  if IS_ARM_MAC
    # YOUR FIX: Use the upstream Rocky Libvirt box directly
    config.vm.box = "rocky9-arm64-direct"
    config.vm.box_url = "https://download.rockylinux.org/pub/rocky/9/images/aarch64/Rocky-9-Vagrant-Libvirt.latest.aarch64.box"

    config.vm.provider "qemu" do |qe|
      qe.machine = "virt"
      qe.cpu = "max"
      qe.memory = "2048"
      qe.net_device = "virtio-net-device"
      qe.arch = "aarch64"
      qe.extra_qemu_args = %w(-device virtio-rng-pci -device virtio-gpu-pci -display none)
    end
  end

  # ------------------------------------------------------------------------
  # SCENARIO B: LINUX AMD64 (Your Server / Colleague's Machine)
  # Advantage: Supports Snapshots (`vagrant snapshot save`) and Packaging.
  # ------------------------------------------------------------------------
  if IS_LINUX
    # Use the standard generic box (works perfectly on Linux/Libvirt)
    config.vm.box = "generic/rocky9"

    # We use 'libvirt', which is the Enterprise version of QEMU
    config.vm.provider "libvirt" do |kvm|
      kvm.driver = "kvm"
      kvm.memory = 2048
      kvm.cpus = 2
    end
  end

  # ------------------------------------------------------------------------
  # SCENARIO C: VIRTUALBOX (Legacy / Intel Mac / Windows)
  # Advantage: Slow, but universally compatible. Supports Snapshots.
  # ------------------------------------------------------------------------
  config.vm.provider "virtualbox" do |vb|
    # Override the box specifically for VirtualBox provider
    override.vm.box = "bento/rocky-linux-9"
    vb.memory = "2048"
    vb.cpus = 2
    vb.gui = false
  end

end
