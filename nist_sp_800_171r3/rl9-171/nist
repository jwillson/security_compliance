#!/usr/bin/env bash
#
# nist - the one command of this toolkit that runs on the host. Everything
# else runs inside its control-plane container, which this starts; the host
# needs bash and podman or docker, and for the lab the hypervisor - nothing of
# this project (TASKS C2, C8).
#
#   ./nist help                       the commands below
#   ./nist COMMAND [ARGS...]          one of them
#   ./nist make TARGET                any make target (make all, make validate...)
#   ./nist bash                       a shell inside the container
#   ./nist ANY-PROGRAM [ARGS...]      any program in the image (ansible-vault, ssh...)
#   ./nist --rebuild ...              rebuild the image first
#
# The image (container/Containerfile: Ubuntu 26.04, pinned ansible-core and
# collections, the libvirt client, the ISO tools) is built on first use and
# tagged by a hash of what it is built from, so a change to the Containerfile
# or requirements.yml builds a new one. The container runs as you, on the
# host network (it reaches targets as the host does), with the repository,
# ~/.ssh and the BYO lab directory ($NIST_BYO_LAB) mounted at their own paths,
# and the host's libvirt socket. NIST_* pass through.
#
# ssh takes the home directory from the passwd entry, not $HOME, so the
# container gets one for you with your home: the image's own uid 1000
# ("ubuntu", /home/ubuntu) would otherwise send it to a known_hosts that does
# not exist (DEFECTS 7.23).
#
# SELinux labelling is off for this container rather than :Z on the mounts:
# relabelling ~/.ssh for a container would stop the host's own sshd from
# reading authorized_keys on Fedora and RHEL.
#
# `diagnose` alone runs privileged, and must be run as root (sudo ./nist
# diagnose): it puts a network namespace on the lab bridge and reads the NAT
# rules. (NIST_PRIVILEGED=1 is what it sets.)
#
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(git -C "$HERE" rev-parse --show-toplevel 2>/dev/null || (cd "$HERE/../.." && pwd))"
RT=${NIST_CONTAINER_RUNTIME:-$(command -v podman || command -v docker || true)}
[[ -n "$RT" ]] || { echo "error: needs podman or docker (NIST_CONTAINER_RUNTIME to choose)" >&2; exit 2; }
LAB="${NIST_BYO_LAB:-$HOME/.local/share/nist-byo-lab}"

rebuild=0
[[ "${1:-}" == --rebuild ]] && { rebuild=1; shift; }

# The commands: each a script inside the repository, run in the container.
# (The scripts enter the container by themselves too, but this is the way
# in: it needs no python3 or make on the host.)
COMMANDS='
apply|apply.sh|harden hosts: --limit HOST, --check --diff, --tags ID, --reboot
verify|verify.sh|assess hosts: --host HOST, --failed-only, --requirement ID
inventory|tools/inventory.py|add / remove / check / show hosts in the inventory
vault|tools/vault.sh|an inventory'"'"'s secrets, encrypted (ansible-vault)
iso|install/iso.sh|a bare-metal install ISO for one machine (--disk /dev/disk/by-id/...)
probe|tools/probe.sh|a read-only probe from tools/probes/ on inventory hosts
lab-ssh|tools/lab-ssh.sh|SSH into a hardened host, both factors answered
lab-console|tools/lab-console.sh|a lab guest'"'"'s serial console
host-check|vm/host-check.sh|can this host run the lab (asks libvirt)
build-vm|vm/build-vm.sh|a kickstart-lab guest (--role log: the collector; --destroy)
byo-lab-init|vm/byo-lab-init.sh|the BYO lab'"'"'s directory and vault
byo-guest|vm/byo-guest.sh|a BYO lab guest: build / check / destroy
lab-network|vm/lab-network.sh|the lab network: ensure / destroy / upstream
teardown|vm/lab-teardown.sh|remove both labs and all they left
residue|tools/lab-residue.sh|what the labs have in libvirt (--orphans)
diagnose|tools/diagnose-lab-net.sh|why a guest cannot reach the mirror (as root: sudo ./nist diagnose)
install-log|tools/install-log.sh|what an installer said before it stopped
console-record|tools/console-record.sh|record a guest'"'"'s console across restarts
harden-cycle|tools/harden-cycle.sh|one recorded hardening cycle on one host
release-run|tools/release-run.sh|the release gate for one lab
from-scratch|tools/lab-from-scratch.sh|both labs rebuilt from nothing (--yes)
rehearse-baremetal|tools/rehearse-baremetal.sh|the bare-metal install, rehearsed in the lab
portability-host|vm/portability-host.sh|a throwaway host of another distribution
portability-run|tools/portability-run.sh|the kickstart lab on that host
pki|tools/lab-pki.sh|the lab CA and host certificates
secret-scan|tools/secret-scan.sh|no secret anywhere in the history
test-lab-network|tools/test-lab-network.sh|the lab network, by behaviour
test-console-record|tools/test-console-record.sh|the console recorder, by behaviour
'
if [[ $# -eq 0 || "$1" == help || "$1" == -h || "$1" == --help ]]; then
  echo "./nist COMMAND [ARGS...] - the toolkit, run in its container"
  echo
  awk -F'|' 'NF {printf "  %-20s %s\n", $1, $3}' <<<"$COMMANDS"
  echo
  echo "  ./nist make TARGET    any make target: make all, make validate, make test, make vm ..."
  echo "  ./nist bash           a shell inside the container"
  echo "  ./nist PROGRAM ...    any program in the image (ansible-vault, ssh, ssh-keygen, virsh ...)"
  exit 0
fi
script=$(awk -F'|' -v c="$1" '$1 == c {print $2}' <<<"$COMMANDS")
if [[ -n "$script" ]]; then
  [[ "$1" == diagnose ]] && export NIST_PRIVILEGED=1
  shift; set -- "$HERE/$script" "$@"
fi

tag=$(cat "$HERE/container/Containerfile" "$HERE/requirements.yml" | sha256sum | cut -c1-12)
image="localhost/nist-control:$tag"
if (( rebuild )) || ! "$RT" image inspect "$image" >/dev/null 2>&1; then
  echo "==> building $image (container/Containerfile)" >&2
  "$RT" build -q -t "$image" -f "$HERE/container/Containerfile" "$HERE" >&2
fi

mounts=(-v "$REPO:$REPO")
# The host's libvirt, by its socket: the client tools inside drive the
# hypervisor outside, as any libvirt client does (the lab-in-container spike,
# DEFECTS 7.34). Access is the host's - your membership of its libvirt group,
# carried in below.
[[ -d /run/libvirt ]] && mounts+=(-v /run/libvirt:/run/libvirt)
# A tool that must show a file at the path the hypervisor sees it by (an ISO
# uploaded into a pool) adds "-v SRC:DST:ro ..." here.
read -r -a extra <<<"${NIST_CONTAINER_MOUNTS:-}"
mounts+=(${extra[@]+"${extra[@]}"})
# Made if missing (0700, as ssh wants it): unmounted, a key ssh-keygen wrote
# inside stayed inside and went with the container.
install -d -m 0700 "$HOME/.ssh"
mounts+=(-v "$HOME/.ssh:$HOME/.ssh")
# Where the host resolves names, read-only, for vm/lab-network.sh's DNS
# forwarder (DEFECTS 7.29): the host's own resolv.conf - what libvirt's
# dnsmasq reads; the container's is podman's - and systemd-resolved's and
# NetworkManager's files.
[[ -e /etc/resolv.conf ]] && mounts+=(-v "$(readlink -f /etc/resolv.conf):/host/etc/resolv.conf:ro")
# Which distribution the host is, for vm/host-check.sh's package advice.
[[ -e /etc/os-release ]] && mounts+=(-v "$(readlink -f /etc/os-release):/host/etc/os-release:ro")
for d in /run/systemd/resolve /run/NetworkManager; do
  [[ -d "$d" ]] && mounts+=(-v "$d:/host$d:ro")
done
[[ -d "$LAB" ]] && mounts+=(-v "$LAB:$LAB")
# Ansible's own state goes to /tmp: inside the container $HOME exists only as
# the mount point for ~/.ssh, and ~/.ansible could not be created there - the
# SSH control sockets included, whose directory ANSIBLE_HOME does not move.
envs=(-e HOME="$HOME" -e USER="${USER:-$(id -un)}" -e TERM="${TERM:-dumb}"
      -e ANSIBLE_HOME=/tmp/ansible-home -e ANSIBLE_LOCAL_TEMP=/tmp/ansible-local
      -e ANSIBLE_SSH_CONTROL_PATH_DIR=/tmp/ansible-cp -e XDG_CACHE_HOME=/tmp/cache)
# The host's SSH agent, when there is one: the keys it holds - ssh-add'ed,
# or on a hardware token - authenticate from inside without the private key
# ever entering the container (`--key agent` in ./nist inventory and iso).
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
  mounts+=(-v "$SSH_AUTH_SOCK:/run/nist-ssh-agent.sock")
  envs+=(-e SSH_AUTH_SOCK=/run/nist-ssh-agent.sock)
fi
while IFS='=' read -r k _; do envs+=(-e "$k"); done < <(env | grep -E '^(NIST_|SSH_ASKPASS|ANSIBLE_)' | grep -v '^ANSIBLE_COLLECTIONS_PATH=' || true)
uid=$(id -u) gid=$(id -g)
passwd="${XDG_RUNTIME_DIR:-/tmp}/nist-control-$tag-$uid.passwd"
if [[ ! -s "$passwd" ]]; then
  "$RT" run --rm --entrypoint cat "$image" /etc/passwd \
    | awk -F: -v u="$uid" '$3 != u' > "$passwd.tmp"
  echo "${USER:-$(id -un)}:x:$uid:$gid::$HOME:/bin/bash" >> "$passwd.tmp"
  mv "$passwd.tmp" "$passwd"
fi
mounts+=(-v "$passwd:/etc/passwd:ro")
# Your supplementary groups (libvirt among them) come along: podman's
# keep-groups (crun), docker's by number.
# As root (rootful podman, or docker run by root) there is nothing to map:
# keep-id is rootless podman's alone, and refused otherwise.
if (( uid == 0 )); then user=()
elif [[ "$(basename "$RT")" == podman ]]; then user=(--userns=keep-id --group-add keep-groups)
else user=(--user "$uid:$gid"); for g in $(id -G); do user+=(--group-add "$g"); done; fi
# stdin always (-i), so a command can be fed - `./nist ssh HOST sudo bash -s
# < tools/probes/hardware.sh` got nothing without it; a terminal only when
# there is one.
tty=(-i); [[ -t 0 && -t 1 ]] && tty=(-it)
priv=()
if [[ "${NIST_PRIVILEGED:-}" == 1 ]]; then
  (( uid == 0 )) || { echo "error: NIST_PRIVILEGED needs root (sudo)" >&2; exit 2; }
  priv=(--privileged)
fi

# The command is looked for first: catatonit, the init, reported a missing
# one as "failed to exec pid1: No such file or directory".
# --init: a small init as PID 1 forwards signals, so a command run here
# stops when told to; as PID 1 itself it ignored SIGTERM and outlived the
# tool that started it (DEFECTS 7.34).
exec "$RT" run --rm --init "${tty[@]}" ${priv[@]+"${priv[@]}"} --network host --security-opt label=disable "${user[@]}" \
  "${mounts[@]}" "${envs[@]}" -w "$PWD" "$image" \
  sh -c 'command -v "$1" >/dev/null 2>&1 || { echo "error: no command \"$1\" in the control-plane image (./nist bash for a shell)" >&2; exit 127; }; exec "$@"' nist "$@"
