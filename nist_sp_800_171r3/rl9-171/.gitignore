# Credentials and key material - never commit these.
.secrets/

# Large downloaded artifacts.
iso/*.iso
iso/CHECKSUM

# Generated per-host, not part of the baseline.
# Every live inventory: one per lab (NIST_INVENTORY). The example is tracked.
inventory/*.yml
reports/*.json
reports/*.html
# tools/harden-cycle.sh: one directory of logs and evidence per run.
reports/runs/
# Python bytecode from running tools/ and tests/.
__pycache__/

# Derived from the PDF; regenerate with `make catalog`.
# Tracked deliberately so the mapping can be reviewed in diffs:
!catalog/requirements.json
