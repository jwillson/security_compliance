# 03.03.05c  Receive audit records forwarded by the CUI hosts.
# Managed by Ansible (roles/nist_log_collector); edits are overwritten.

{% if nist_col_tls_ready %}
# 03.13.08  TLS with mutual x509 authentication. A forwarder is accepted only
# if it presents a certificate issued by the CA whose name is on the list
# below - the cui_hosts of the inventory this was applied from.
global(DefaultNetstreamDriver="ossl"
       DefaultNetstreamDriverCAFile="/etc/pki/rsyslog/ca.crt"
       DefaultNetstreamDriverCertFile="/etc/pki/rsyslog/host.crt"
       DefaultNetstreamDriverKeyFile="/etc/pki/rsyslog/host.key")
module(load="imtcp"
       MaxSessions="200"
       StreamDriver.Name="ossl"
       StreamDriver.Mode="1"
       StreamDriver.AuthMode="x509/name"
       PermittedPeer=[{{ nist_col_peers | map('to_json') | join(', ') }}])
{% else %}
# Plaintext: nist_log_tls is false. Acceptable only on an isolated network.
module(load="imtcp"
       MaxSessions="200")
{% endif %}
input(type="imtcp" port="{{ nist_collector_port }}")

# One directory per sending host, so records stay attributable to the system
# that produced them - named after the peer the connection came from, by its
# address, never after %HOSTNAME%: that is whatever the sender wrote in the
# record, so one permitted peer could file records as another (issue #10).
# Under mutual TLS the address belongs to a peer the CA vouched for. An
# address the inventory does not know is filed as unknown-<ip>, and counts
# for nothing in au-05-collector-receiving.
template(name="NistRemoteFile" type="string"
         string="{{ nist_remote_log_dir }}/%$.nistsrc%/%PROGRAMNAME:::secpath-replace%.log")

# 0600 root:root, matching the protection the records had on their origin
# host (03.03.08a).
$umask 0077
$DirCreateMode 0700
$FileCreateMode 0600
$DirOwner root
$DirGroup root
$FileOwner root
$FileGroup root

if ($fromhost-ip != "127.0.0.1") then {
    set $.nistsrc = "unknown-" & $fromhost-ip;
{% for p in nist_col_peers %}
{%   set addr = hostvars[p].ansible_host | default(p) %}
{%   if addr is match('^[0-9.]+$') or ':' in addr %}
    if $fromhost-ip == "{{ addr }}" then { set $.nistsrc = "{{ p }}"; }
{%   else %}
    if $fromhost == "{{ addr }}" then { set $.nistsrc = "{{ p }}"; }
{%   endif %}
{% endfor %}
    action(type="omfile" dynaFile="NistRemoteFile")
    stop
}
