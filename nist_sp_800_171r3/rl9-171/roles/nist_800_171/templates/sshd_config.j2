# NIST SP 800-171r3 sshd hardening - managed by Ansible.
#
# SSH is the only authorized remote access path to this host, so it carries
# several requirements at once:
#
#   03.01.12  Remote Access - managed access control point
#   03.01.06  No direct privileged login
#   03.01.09  System use notification before authentication
#   03.05.03  Multi-factor authentication
#   03.05.04  Replay-resistant authentication
#   03.05.11  Authentication feedback obscured
#   03.13.08  Transmission confidentiality
#   03.13.09  Network disconnect on idle
#   03.13.15  Session authenticity

# --- 03.01.06 Privileged accounts -------------------------------------------
# Root must log in as a named user and escalate, so actions stay attributable.
PermitRootLogin no

# --- 03.05.01 / 03.01.06 Authentication ------------------------------------
PermitEmptyPasswords no
PermitUserEnvironment no
StrictModes yes
IgnoreRhosts yes
HostbasedAuthentication no
# 03.05.04: GSSAPI and host-based auth are removed rather than relied on.
GSSAPIAuthentication no
KerberosAuthentication no

{% if nist_mfa_enforce_pubkey %}
# --- 03.05.03 Multi-factor authentication -----------------------------------
# Two independent factors: something held (the private key) and something
# known (the account password). Set nist_mfa_enforce_pubkey=false only if
# operators have not yet enrolled keys.
PubkeyAuthentication yes
PasswordAuthentication yes
AuthenticationMethods publickey,password
{% else %}
# MFA not enforced on this host - recorded as a deviation by the auditor.
PubkeyAuthentication yes
PasswordAuthentication yes
AuthenticationMethods any
{% endif %}

# 03.01.08: bound the attempts a single connection may make.
MaxAuthTries {{ odp.lockout_attempts }}
MaxSessions 4
MaxStartups 10:30:60
LoginGraceTime 60

# --- 03.01.09 System use notification ---------------------------------------
Banner /etc/issue.net
PrintMotd yes
PrintLastLog yes

# --- 03.13.09 Network disconnect / 03.01.11 Session termination -------------
{% if nist_openssh_version is version('9.2', '>=') %}
# An SSH session idle for {{ odp.session_timeout_seconds }}s is closed whatever runs in it, and a
# connection left with no session open is dropped after the same period.
# (TMOUT alone ends only an idle bash prompt.) "session*", not "session":
# once a session starts a shell, a command or sftp, sshd relabels its channel
# session:shell / session:command / session:subsystem:sftp and looks the
# timeout up again under that name (channels.c channel_set_xtype), so a bare
# "session" applies to no running session at all (DEFECTS 6b.3).
ChannelTimeout session*={{ odp.session_timeout_seconds }}s
UnusedConnectionTimeout {{ odp.session_timeout_seconds }}s
{% else %}
# OpenSSH {{ nist_openssh_version }} predates ChannelTimeout (9.2): only TMOUT ends
# idle sessions here. The assessor reports it; update openssh-server.
{% endif %}
# Dead-peer detection, not idle termination: an unresponsive client is dropped
# one interval after the first unanswered probe; a live idle client answers
# them, so idle sessions are ended by ChannelTimeout above. (0 would disable
# termination altogether - sshd_config(5); DEFECTS 6b.3.)
ClientAliveInterval {{ odp.ssh_client_alive_interval }}
ClientAliveCountMax {{ odp.ssh_client_alive_count_max }}
TCPKeepAlive yes

# --- 03.04.06 Least functionality -------------------------------------------
# Forwarding creates uncontrolled flow paths through the boundary (03.01.03).
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
AllowStreamLocalForwarding no

# --- 03.13.08 / 03.13.11 / 03.13.15 Cryptography ----------------------------
# Algorithms are inherited from the system-wide FIPS crypto policy rather than
# pinned here, so a policy change cannot be silently bypassed by this file.
# The policy is set by crypto-policies (03.13.11) and verified by the auditor.
RekeyLimit 512M 1h

# 03.03.01: log at a level that records authentication events.
LogLevel VERBOSE
SyslogFacility AUTHPRIV

UsePAM yes
Compression no
