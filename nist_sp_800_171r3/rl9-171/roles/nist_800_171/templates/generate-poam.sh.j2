#!/usr/bin/env bash
# 03.12.02  Merge the latest assessment into the POA&M register.
#
# The register, {{ nist_conf_dir }}/poam.csv, persists: the owner's columns
# (Scheduled Completion, Responsible Party, Resources Required, Milestones,
# Owner Notes) are carried forward on every run, a resolved deviation is
# closed with its date rather than deleted, and the owner closes residual
# items. A dated snapshot goes to {{ nist_report_dir }}. The logic, and the
# rules it follows, are {{ nist_bin_dir }}/nist_poam.py (tests: tests/test_poam.py
# in the repository). Runs after every scheduled assessment
# (nist-assessment.service) and by hand as `nist-generate-poam`.
set -euo pipefail
exec /usr/bin/python3 {{ nist_bin_dir }}/nist_poam.py \
  --assessment {{ nist_report_dir }}/assessment-latest.json \
  --register {{ nist_conf_dir }}/poam.csv \
  --snapshot-dir {{ nist_report_dir }} "$@"
